  "type": "dravencms-package",
  "description": "Carousel module for dravencms",
  "keywords": [
    "dravencms",
    "carousel"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "dravencms/file": "^2.0",
    "dravencms/admin": "^3.0",
    "dravencms/structure": "^2.3",
    "php": "^8.4",
    "dravencms/application": "^0.3"
  },
  "require-dev": {
    "nette/tester": "^2.6"
  },
  "autoload": {
    "psr-0": {
